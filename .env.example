# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# Database Configuration (LogAnalyticsPipeline)
# ==============================================================================
# Full SQLAlchemy connection string:
# mysql+pymysql://<user>:<password>@<host>:<port>/<database>?charset=utf8mb4
# SQLite: sqlite:///./log_analytics.db
DATABASE_URL="mysql+pymysql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:3306/YOUR_DB_NAME?charset=utf8mb4"

# Discrete MySQL connection parameters (used if DATABASE_URL is not set)
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="YOUR_DB_USER"
DB_PASSWORD="YOUR_DB_PASSWORD"
DB_NAME="YOUR_DB_NAME"

# Pipeline Input, Quarantine, and Report Directories
LOG_INPUT_DIR="data/sample"
QUARANTINE_DIR="output/quarantine"
REPORTS_DIR="output/reports"
BATCH_SIZE="5000"
LOG_LEVEL="INFO"
